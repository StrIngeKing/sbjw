{
  "name": "dsh-reliability-guard",
  "version": "1.1.5",
  "description": "可靠性守卫 / Reliability Guard for DeepSeek Harness: 为 DeepSeek Harness 提供确定性的证据、循环、风险、验证与完成门禁。 / Deterministic evidence, loop, risk, verification, and completion gates.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "reliability",
    "guard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrIngeKing/dsh-reliability-guard.git"
  },
  "bugs": {
    "url": "https://github.com/StrIngeKing/dsh-reliability-guard/issues"
  },
  "homepage": "https://github.com/StrIngeKing/dsh-reliability-guard#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2 || 0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:seams": "node --test test/01-prompt-section.test.js test/02-session-isolation.test.js test/03-evidence-invalidation.test.js test/04-loop-guard.test.js test/05-risk-classifier.test.js",
    "test:gates": "node --test test/08-windows-powershell.test.js test/11-12-completion-gate.test.js test/13-reviewer.test.js test/14-freshness-gate.test.js test/15-diagnostics-privacy.test.js",
    "verify:pack": "node scripts/verify-pack.mjs"
  }
}
