  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:seams": "node --test test/01-prompt-section.test.js test/02-session-isolation.test.js test/03-evidence-invalidation.test.js test/04-loop-guard.test.js test/05-risk-classifier.test.js",
